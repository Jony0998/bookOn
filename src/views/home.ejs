<%- include('includes/header') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

<body class="app-bg">
  <div class="app-shell">

    <!-- SIDEBAR -->
    <aside class="app-sidebar">
      <div class="brand">
        <div class="brand-icon">📚</div>
        <div class="brand-text">
          <div class="brand-name">BOOKON</div>
          <div class="brand-tag">Admin Panel</div>
        </div>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">Navigation</div>
        <ul class="nav-list">
          <li class="nav-item active">
            <a class="nav-link" href="/admin">
              <i class="bi bi-house-door-fill"></i> Dashboard
            </a>
          </li>
          <% if(!member) { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/signup">
              <i class="bi bi-person-plus-fill"></i> Sign Up
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/login">
              <i class="bi bi-box-arrow-in-right"></i> Login
            </a>
          </li>
          <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/admin/product/all">
              <i class="bi bi-grid-3x3-gap-fill"></i> Products
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/user/all">
              <i class="bi bi-people-fill"></i> Users
            </a>
          </li>
          <% } %>
        </ul>
      </div>

      <% if(member) { %>
      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="sidebar-user-avatar">👤</div>
          <div class="sidebar-user-info">
            <div class="sidebar-user-name"><%= member.memberNick %></div>
            <div class="sidebar-user-role">Administrator</div>
          </div>
          <a href="/admin/logout" onclick="return confirm('Are you sure you want to logout?')" style="color:var(--muted);font-size:18px;">
            <i class="bi bi-box-arrow-right"></i>
          </a>
        </div>
      </div>
      <% } %>
    </aside>

    <!-- MAIN -->
    <div class="app-main">

      <header class="app-topbar">
        <div class="topbar-left">
          <div class="topbar-breadcrumb">
            <i class="bi bi-house-door"></i>
            <span>/</span>
            <span class="current">Dashboard</span>
          </div>
        </div>
        <div class="topbar-right">
          <div class="topbar-dot"></div>
          <span class="topbar-badge">
            <i class="bi bi-shield-check me-1"></i>Admin
          </span>
        </div>
      </header>

      <main class="app-content">

        <!-- HERO -->
        <div class="dash-hero">
          <div class="hero-content">
            <div class="hero-greeting">
              <i class="bi bi-stars"></i> Welcome back
            </div>
            <h1 class="hero-title">
              BOOKON <span>Admin Panel</span>
            </h1>
            <p class="hero-desc">
              Manage your library products, users, and orders. Everything is under your control with the modern admin panel.
            </p>
            <% if(!member) { %>
            <div class="hero-actions">
              <a class="btn-hero-primary" href="/admin/signup">
                <i class="bi bi-person-plus-fill"></i> Get Started
              </a>
              <a class="btn-hero-secondary" href="/admin/login">
                <i class="bi bi-box-arrow-in-right"></i> Login
              </a>
            </div>
            <% } else { %>
            <div class="hero-actions">
              <a class="btn-hero-primary" href="/admin/product/all">
                <i class="bi bi-grid-3x3-gap-fill"></i> Products
              </a>
              <a class="btn-hero-secondary" href="/admin/user/all">
                <i class="bi bi-people-fill"></i> Users
              </a>
            </div>
            <% } %>
          </div>
          <div class="hero-decoration">
            <div class="hero-book"></div>
          </div>
        </div>

        <% if(member) { %>

        <!-- STAT CARDS -->
        <div class="stat-cards">
          <div class="stat-card-new card-indigo">
            <div class="stat-card-top">
              <div class="stat-icon-new indigo"><i class="bi bi-book-fill"></i></div>
              <div class="stat-trend up"><i class="bi bi-arrow-up"></i> Live</div>
            </div>
            <div class="stat-value-new">∞</div>
            <div class="stat-label-new">Total Products</div>
          </div>

          <div class="stat-card-new card-gold">
            <div class="stat-card-top">
              <div class="stat-icon-new gold"><i class="bi bi-people-fill"></i></div>
              <div class="stat-trend up"><i class="bi bi-arrow-up"></i> Active</div>
            </div>
            <div class="stat-value-new">∞</div>
            <div class="stat-label-new">Total Users</div>
          </div>

          <div class="stat-card-new card-green">
            <div class="stat-card-top">
              <div class="stat-icon-new green"><i class="bi bi-bag-check-fill"></i></div>
              <div class="stat-trend up"><i class="bi bi-arrow-up"></i> New</div>
            </div>
            <div class="stat-value-new">∞</div>
            <div class="stat-label-new">Orders</div>
          </div>

          <div class="stat-card-new card-cyan">
            <div class="stat-card-top">
              <div class="stat-icon-new cyan"><i class="bi bi-graph-up-arrow"></i></div>
              <div class="stat-trend up"><i class="bi bi-arrow-up"></i> Up</div>
            </div>
            <div class="stat-value-new">∞</div>
            <div class="stat-label-new">Monthly Revenue</div>
          </div>
        </div>

        <!-- QUICK ACTIONS -->
        <div class="quick-grid">
          <a class="quick-card" href="/admin/product/all">
            <div class="quick-card-icon" style="background:rgba(99,102,241,.15);color:#818cf8;">
              <i class="bi bi-grid-3x3-gap-fill"></i>
            </div>
            <h5>Products</h5>
            <p>View and manage the book catalog</p>
            <div class="quick-card-arrow"><i class="bi bi-arrow-right"></i></div>
          </a>

          <a class="quick-card" href="/admin/user/all">
            <div class="quick-card-icon" style="background:rgba(245,158,11,.15);color:#fbbf24;">
              <i class="bi bi-people-fill"></i>
            </div>
            <h5>Users</h5>
            <p>Manage user list and status</p>
            <div class="quick-card-arrow"><i class="bi bi-arrow-right"></i></div>
          </a>

          <a class="quick-card" href="/admin/logout" onclick="return confirm('Are you sure you want to logout?')">
            <div class="quick-card-icon" style="background:rgba(239,68,68,.12);color:#f87171;">
              <i class="bi bi-box-arrow-right"></i>
            </div>
            <h5>Logout</h5>
            <p>Sign out from admin panel</p>
            <div class="quick-card-arrow"><i class="bi bi-arrow-right"></i></div>
          </a>
        </div>

        <% } %>

      </main>
    </div>
  </div>

  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
