<%- include('includes/header') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

<body class="app-bg">
  <div class="app-shell">
    <aside class="app-sidebar">
      <div class="brand">
        <span class="dot"></span>
        <span>BOOKON</span>
      </div>
      <ul class="nav-list">
        <li class="nav-item active">
          <a class="nav-link" href="/admin"><i class="bi bi-house-door"></i> Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item"><a class="nav-link" href="/admin/signup"><i class="bi bi-person-plus"></i> Signup</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/login"><i class="bi bi-box-arrow-in-right"></i> Login</a></li>
        <% } else { %>
        <li class="nav-item"><a class="nav-link" href="/admin/product/all"><i class="bi bi-grid"></i> Products</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/user/all"><i class="bi bi-people"></i> Users</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/logout" onclick="return confirm('Do you want to logout?')"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
        <% } %>
      </ul>
    </aside>

    <div class="app-main">
      <header class="app-topbar">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-house-door text-primary"></i>
          <span class="fw-semibold text-white">Home</span>
        </div>
        <span class="text-muted small">Welcome to the new dashboard</span>
      </header>

      <main class="app-content">
        <div class="hero mb-4">
          <div class="row align-items-center g-3">
            <div class="col-lg-7">
              <h1 class="fw-bold mb-2">Welcome to BOOKON</h1>
              <p class="text-muted mb-3">Manage your library menu, users, and orders with a fresh dark UI.</p>
              <% if(!member) { %>
                <div class="d-flex gap-2">
                  <a class="btn btn-primary" href="/admin/signup">Get Started</a>
                  <a class="btn btn-secondary" href="/admin/login">Login</a>
                </div>
              <% } else { %>
                <div class="d-flex gap-2">
                  <a class="btn btn-primary" href="/admin/product/all">Go to Products</a>
                  <a class="btn btn-secondary" href="/admin/user/all">View Users</a>
                </div>
              <% } %>
            </div>
            <div class="col-lg-5">
              <div class="card-glass h-100">
                <div class="mb-3">
                  <span class="badge badge-soft">Overview</span>
                </div>
                <h4 class="fw-semibold">Today’s snapshot</h4>
                <p class="text-muted mb-4">Quick stats about your library.</p>
                <div class="d-flex flex-column gap-3">
                  <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background: rgba(79,139,255,0.08); border: 1px solid var(--border);">
                    <div>
                      <div class="text-muted small">Active users</div>
                      <div class="fw-bold fs-4 text-white">1,248</div>
                    </div>
                    <i class="bi bi-people fs-3 text-primary"></i>
                  </div>
                  <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background: rgba(127,93,255,0.08); border: 1px solid var(--border);">
                    <div>
                      <div class="text-muted small">New items</div>
                      <div class="fw-bold fs-4 text-white">56</div>
                    </div>
                    <i class="bi bi-book fs-3 text-primary"></i>
                  </div>
                  <div class="d-flex align-items-center justify-content-between p-3 rounded-3" style="background: rgba(0,212,255,0.08); border: 1px solid var(--border);">
                    <div>
                      <div class="text-muted small">Pending orders</div>
                      <div class="fw-bold fs-4 text-white">12</div>
                    </div>
                    <i class="bi bi-bag fs-3 text-primary"></i>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <% if(member) { %>
        <div class="row g-3 mt-3">
          <div class="col-md-4">
            <div class="stat-card">
              <div class="text-muted small">Quick Access</div>
              <div class="stat-value">Products</div>
              <a class="btn btn-primary btn-sm mt-2" href="/admin/product/all">Open</a>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-card">
              <div class="text-muted small">Manage</div>
              <div class="stat-value">Users</div>
              <a class="btn btn-secondary btn-sm mt-2" href="/admin/user/all">Open</a>
            </div>
          </div>
        </div>
        <% } %>
      </main>
    </div>
  </div>

  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
