<%
  const current = typeof active !== "undefined" ? active : "";
  const me = typeof admin !== "undefined" && admin ? admin : null;
  const pending = typeof pendingCount !== "undefined" ? pendingCount : 0;
  const newInquiries = typeof inquiryCount !== "undefined" ? inquiryCount : 0;
%>
<div class="ad-mobilebar">
  <button type="button" class="ad-menu-toggle" aria-label="Menyu" aria-controls="ad-side" aria-expanded="false"><i class="bi bi-list"></i></button>
  <span class="ad-brand__name">Book<span>On</span></span>
  <span style="width:42px"></span>
</div>

<aside class="ad-side" id="ad-side">
  <a class="ad-brand" href="/admin">
    <svg width="34" height="34" viewBox="0 0 40 40" aria-hidden="true" style="color:#3cc3c8;flex:none">
      <rect x="9" y="9" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" />
      <rect x="9" y="9" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" transform="rotate(45 20 20)" />
      <circle cx="20" cy="20" r="3.2" fill="#f2b53a" />
    </svg>
    <span>
      <span class="ad-brand__name">Book<span>On</span></span>
      <span class="ad-brand__tag">Boshqaruv paneli</span>
    </span>
  </a>

  <nav class="ad-nav" aria-label="Boshqaruv">
    <span class="ad-nav__label">Boshqaruv</span>
    <a href="/admin" class="<%= current === 'home' ? 'is-active' : '' %>" <%= current === 'home' ? 'aria-current=page' : '' %>><i class="bi bi-grid-1x2"></i> Bosh panel</a>
    <a href="/admin/order/all" class="<%= current === 'orders' ? 'is-active' : '' %>" <%= current === 'orders' ? 'aria-current=page' : '' %>>
      <i class="bi bi-box-seam"></i> Buyurtmalar
      <% if (pending > 0) { %><span class="ad-nav__badge" title="Kutilayotgan buyurtmalar"><%= pending %></span><% } %>
    </a>
    <a href="/admin/inquiry/all" class="<%= current === 'inquiries' ? 'is-active' : '' %>" <%= current === 'inquiries' ? 'aria-current=page' : '' %>>
      <i class="bi bi-chat-left-text"></i> Murojaatlar
      <% if (newInquiries > 0) { %><span class="ad-nav__badge" title="Javob kutayotgan murojaatlar"><%= newInquiries %></span><% } %>
    </a>
    <a href="/admin/product/all" class="<%= current === 'products' ? 'is-active' : '' %>" <%= current === 'products' ? 'aria-current=page' : '' %>><i class="bi bi-book"></i> Kitoblar</a>
    <a href="/admin/article/all" class="<%= current === 'articles' ? 'is-active' : '' %>" <%= current === 'articles' ? 'aria-current=page' : '' %>><i class="bi bi-newspaper"></i> Yangiliklar</a>
    <a href="/admin/user/all" class="<%= current === 'users' ? 'is-active' : '' %>" <%= current === 'users' ? 'aria-current=page' : '' %>><i class="bi bi-people"></i> Kitobxonlar</a>
  </nav>

  <div class="ad-side__foot">
    <div class="ad-side__row">
      <a class="ad-side__btn" href="/" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Sayt</a>
      <button type="button" class="ad-side__btn ad-theme-toggle" aria-label="Rejimni almashtirish"><i class="bi bi-moon-stars"></i> <span>Rejim</span></button>
    </div>
    <% if (me) { %>
    <div class="ad-me">
      <img src="<%= me.memberImage ? '/' + me.memberImage : '/img/default.jpeg' %>" alt="" onerror="this.src='/img/default.jpeg'" />
      <div>
        <div class="ad-me__name"><%= me.memberNick %></div>
        <div class="ad-me__role">Kutubxona</div>
      </div>
      <a href="/admin/logout" onclick="return confirm('Hisobdan chiqasizmi?')" title="Chiqish" aria-label="Chiqish"><i class="bi bi-box-arrow-right"></i></a>
    </div>
    <% } %>
  </div>
</aside>
