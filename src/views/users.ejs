<%- include('includes/header', { pageTitle: 'Kitobxonlar' }) %>
<%
  const count = (st) => users.filter(function (u) { return u.memberStatus === st; }).length;
  const avatar = (u) => u.memberImage ? '/' + u.memberImage : '/img/default.jpeg';
%>
<body>
  <div class="ad-shell">
    <%- include('includes/sidebar') %>

    <main class="ad-main">
      <header class="ad-head">
        <div>
          <span class="ad-eyebrow">Hamjamiyat</span>
          <h1>Kitobxonlar</h1>
          <p>Roʻyxatdan oʻtgan foydalanuvchilar, ularning aloqa maʼlumotlari va hisob holati.</p>
        </div>
      </header>

      <section class="ad-kpis" aria-label="Kitobxonlar koʻrsatkichlari">
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon"><i class="bi bi-people"></i></span>
          <span class="ad-kpi__value ad-num"><%= users.length %></span>
          <span class="ad-kpi__label">Jami</span>
        </div>
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon is-ok"><i class="bi bi-person-check"></i></span>
          <span class="ad-kpi__value ad-num"><%= count('ACTIVE') %></span>
          <span class="ad-kpi__label">Faol</span>
        </div>
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon is-gold"><i class="bi bi-person-lock"></i></span>
          <span class="ad-kpi__value ad-num"><%= count('BLOCK') %></span>
          <span class="ad-kpi__label">Bloklangan</span>
          <span class="ad-kpi__sub">Tizimga kira olmaydi</span>
        </div>
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon is-danger"><i class="bi bi-person-x"></i></span>
          <span class="ad-kpi__value ad-num"><%= count('DELETE') %></span>
          <span class="ad-kpi__label">Oʻchirilgan</span>
        </div>
      </section>

      <section class="ad-card" aria-label="Kitobxonlar roʻyxati">
        <div class="ad-toolbar">
          <label class="ad-search">
            <i class="bi bi-search"></i>
            <span class="visually-hidden">Qidirish</span>
            <input type="search" id="user-search" placeholder="Ism, email yoki telefon boʻyicha qidiring" />
          </label>
          <select class="form-select ad-select" id="user-status-filter" aria-label="Holat" style="width:auto">
            <option value="">Barcha holatlar</option>
            <option value="ACTIVE">Faol</option>
            <option value="BLOCK">Bloklangan</option>
            <option value="DELETE">Oʻchirilgan</option>
          </select>
          <button class="ad-btn ad-btn--ghost ad-btn--sm" id="user-clear-filters" type="button"><i class="bi bi-x-circle"></i> Tozalash</button>
        </div>

        <div class="ad-table-wrap">
          <table class="ad-table" id="users-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Kitobxon</th>
                <th>Aloqa</th>
                <th>Manzil</th>
                <th class="is-num">Ball</th>
                <th>Qoʻshilgan</th>
                <th>Holat</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(function (u, i) { %>
              <tr class="user-row"
                  data-name="<%= [u.memberNick, u.memberEmail || '', u.memberPhone || ''].join(' ').toLowerCase() %>"
                  data-status="<%= u.memberStatus %>">
                <td class="ad-muted ad-num"><%= i + 1 %></td>
                <td>
                  <div class="ad-user">
                    <img src="<%= avatar(u) %>" alt="" onerror="this.src='/img/default.jpeg'" />
                    <div>
                      <div class="ad-user__name"><%= u.memberNick %></div>
                      <div class="ad-user__sub">ID <%= String(u._id).slice(-6).toUpperCase() %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <div style="display:flex;flex-direction:column;gap:2px;font-size:14px">
                    <% if (u.memberEmail) { %>
                      <span><i class="bi bi-envelope ad-muted"></i> <%= u.memberEmail %> <% if (u.memberEmailVerified) { %><i class="bi bi-patch-check-fill" style="color:var(--ok)" title="Tasdiqlangan"></i><% } %></span>
                    <% } %>
                    <% if (u.memberPhone) { %><span><i class="bi bi-telephone ad-muted"></i> <%= u.memberPhone %></span><% } %>
                    <% if (!u.memberEmail && !u.memberPhone) { %><span class="ad-muted">—</span><% } %>
                  </div>
                </td>
                <td style="max-width:240px;font-size:14px"><%= u.memberAddress || '—' %></td>
                <td class="is-num"><strong><%= u.memberPoints || 0 %></strong></td>
                <td class="ad-muted" style="white-space:nowrap;font-size:14px"><%= date(u.createdAt) %></td>
                <td>
                  <select class="form-select ad-status-select member-status" id="<%= u._id %>" aria-label="Holat: <%= u.memberNick %>">
                    <option value="ACTIVE" <%= u.memberStatus === 'ACTIVE' ? 'selected' : '' %>>Faol</option>
                    <option value="BLOCK"  <%= u.memberStatus === 'BLOCK'  ? 'selected' : '' %>>Bloklangan</option>
                    <option value="DELETE" <%= u.memberStatus === 'DELETE' ? 'selected' : '' %>>Oʻchirilgan</option>
                  </select>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <div id="users-no-results" class="ad-no-results" style="display:none;"><i class="bi bi-search"></i> Filtrga mos kitobxon topilmadi</div>
        </div>
      </section>
    </main>
  </div>

  <script type="text/javascript" src="<%= asset('/js/users.js') %>"></script>
<%- include('includes/footer') %>
