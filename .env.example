# Copy to .env and fill in real values. Do not commit .env.

# Server
NODE_ENV=production
PORT=3003

# MongoDB (e.g. Atlas connection string)
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/bookon?retryWrites=true&w=majority

# Session (random string, min 32 chars)
SESSION_SECRET=your-session-secret-key

# JWT (for API auth)
SECRET_TOKEN=your-jwt-secret-key

# Optional: React frontend URL for CORS (e.g. https://bookon.vercel.app). Leave empty to allow all origins.
# FRONTEND_URL=https://your-frontend-domain.com
