<%- include('includes/header', { pageTitle: 'Kutubxonani roʻyxatdan oʻtkazish' }) %>
<body>
  <div class="ad-auth">
    <aside class="ad-auth__art" aria-hidden="true">
      <%- include('includes/girih', { cls: 'ad-girih', pid: 'signup' }) %>
      <span class="ad-brand">
        <svg width="34" height="34" viewBox="0 0 40 40" style="color:#3cc3c8"><rect x="9" y="9" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" /><rect x="9" y="9" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" transform="rotate(45 20 20)" /><circle cx="20" cy="20" r="3.2" fill="#f2b53a" /></svg>
        <span><span class="ad-brand__name">Book<span>On</span></span><span class="ad-brand__tag">Boshqaruv paneli</span></span>
      </span>
      <div>
        <p class="ad-auth__quote">Kutubxonangizni <em>bir daqiqada</em> oching.</p>
        <p class="ad-auth__note">Doʻkonda faqat bitta kutubxona hisobi boʻladi. U kitoblar katalogi va buyurtmalarni boshqaradi.</p>
      </div>
    </aside>

    <section class="ad-auth__panel">
      <% if (libraryExists) { %>
        <div class="ad-auth__form">
          <span class="ad-eyebrow">Kutubxona hisobi</span>
          <h1>Hisob allaqachon mavjud</h1>
          <p class="lead">Bu doʻkonda kutubxona hisobi ochilgan. Ikkinchi hisob yaratib boʻlmaydi — mavjud hisob bilan kiring.</p>
          <a class="ad-btn ad-btn--primary" href="/admin/login" style="min-height:52px"><i class="bi bi-box-arrow-in-right"></i> Kirishga oʻtish</a>
        </div>
      <% } else { %>
      <form class="ad-auth__form" action="/admin/signup" method="POST" enctype="multipart/form-data" onsubmit="return validateSignupForm()">
        <span class="ad-eyebrow">Birinchi qadam</span>
        <h1>Kutubxonani roʻyxatdan oʻtkazish</h1>
        <p class="lead">Bu maʼlumotlar Yordam sahifasida xaridorlar uchun aloqa sifatida koʻrinadi.</p>

        <div class="ad-avatar-pick file-box">
          <img class="upload-img-frame" src="/img/default.jpeg" alt="" />
          <div>
            <label class="ad-btn ad-btn--ghost ad-btn--sm" for="memberImage" style="cursor:pointer"><i class="bi bi-image"></i> Logotip tanlash</label>
            <input class="d-none upload-hidden member-image" id="memberImage" name="memberImage" type="file" accept="image/jpeg,image/png,image/webp" />
            <input class="upload-name form-control mt-2" value="" placeholder="Fayl tanlanmagan" readonly tabindex="-1" style="min-height:34px;font-size:13px" />
          </div>
        </div>

        <div>
          <label class="form-label" for="memberNick">Kutubxona nomi (login) <span class="req">*</span></label>
          <input class="form-control member-nick" id="memberNick" name="memberNick" type="text" autocomplete="username" required />
        </div>
        <div>
          <label class="form-label" for="memberPhone">Telefon <span class="req">*</span></label>
          <input class="form-control member-phone" id="memberPhone" name="memberPhone" type="tel" placeholder="+998 90 123 45 67" autocomplete="tel" required />
        </div>
        <div class="row g-3">
          <div class="col-sm-6">
            <label class="form-label" for="memberPassword">Parol <span class="req">*</span></label>
            <input class="form-control member-password" id="memberPassword" name="memberPassword" type="password" autocomplete="new-password" required />
          </div>
          <div class="col-sm-6">
            <label class="form-label" for="confirmPassword">Parolni takrorlang <span class="req">*</span></label>
            <input class="form-control confirm-password" id="confirmPassword" type="password" autocomplete="new-password" required />
          </div>
        </div>

        <button type="submit" class="ad-btn ad-btn--primary" style="min-height:52px"><i class="bi bi-check2"></i> Hisob yaratish</button>
        <p class="ad-auth__switch">Hisob bormi? <a href="/admin/login" style="font-weight:700">Kirish</a></p>
      </form>
      <% } %>
    </section>
  </div>
  <script type="text/javascript" src="<%= asset('/js/signup.js') %>"></script>
<%- include('includes/footer') %>
