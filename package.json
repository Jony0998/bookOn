{
  "name": "bookon",
  "version": "1.0.0",
  "description": "This is bookon project backend",
  "main": "src/server.ts",
  "scripts": {
    "start": "ts-node src/server.ts",
    "start:dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc && node scripts/copy-assets.js && node extra.js",
    "start:prod": "cross-env NODE_ENV=production node dist/server.js",
    "test": "npm run test:e2e",
    "test:e2e": "node scripts/e2e/auth.e2e.js && node scripts/e2e/admin-products.e2e.js && node scripts/e2e/orders.e2e.js && node scripts/e2e/articles.e2e.js && node scripts/e2e/inquiries.e2e.js && node scripts/e2e/admin-login.e2e.js && node scripts/e2e/security.e2e.js && node scripts/e2e/search.e2e.js && node scripts/e2e/reco.e2e.js && node scripts/e2e/realtime.e2e.js"
  },
  "author": "JONY",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongodb-session": "^3.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "ejs": "^3.1.6",
    "express": "^4.17.3",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.17.3",
    "fs-extra": "^11.1.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^6.2.9",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.6.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/connect-mongodb-session": "^2.4.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.3",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.0.0",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/socket.io": "^3.0.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
