<%- include('includes/header') %>

<body class="app-bg">

  <% if(!member) { %>
  <div class="auth-page-modern">
    <div style="background:var(--card);border:1px solid var(--border);border-radius:20px;padding:48px;text-align:center;max-width:420px;width:100%;">
      <div style="width:64px;height:64px;background:rgba(99,102,241,.15);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 20px;">🔒</div>
      <h3 style="font-weight:800;margin-bottom:8px;color:var(--text);">Kirish talab etiladi</h3>
      <p style="color:var(--muted);margin-bottom:24px;">Foydalanuvchilar sahifasini ko'rish uchun tizimga kirishingiz kerak.</p>
      <a href="/admin/login" class="btn-hero-primary" style="width:100%;justify-content:center;">
        <i class="bi bi-box-arrow-in-right"></i> Tizimga kirish
      </a>
    </div>
  </div>

  <% } else {
      const activeCount = users.filter(u => u.memberStatus === "ACTIVE").length;
      const blockCount  = users.filter(u => u.memberStatus === "BLOCK").length;
      const deleteCount = users.filter(u => u.memberStatus === "DELETE").length;
  %>

  <div class="app-shell">

    <!-- ── SIDEBAR ─────────────────────────── -->
    <aside class="app-sidebar">
      <div class="brand">
        <div class="brand-icon">📚</div>
        <div class="brand-text">
          <div class="brand-name">BOOKON</div>
          <div class="brand-tag">Admin Panel</div>
        </div>
      </div>

      <div class="nav-section">
        <div class="nav-section-label">Navigation</div>
        <ul class="nav-list">
          <li class="nav-item">
            <a class="nav-link" href="/admin/">
              <i class="bi bi-house-door-fill"></i> Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/admin/product/all">
              <i class="bi bi-grid-3x3-gap-fill"></i> Products
            </a>
          </li>
          <li class="nav-item active">
            <a class="nav-link" href="/admin/user/all">
              <i class="bi bi-people-fill"></i> Users
            </a>
          </li>
        </ul>
      </div>

      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="sidebar-user-avatar">👤</div>
          <div class="sidebar-user-info">
            <div class="sidebar-user-name"><%= member.memberNick %></div>
            <div class="sidebar-user-role">Administrator</div>
          </div>
          <a href="/admin/logout" onclick="return confirm('Tizimdan chiqmoqchimisiz?')" style="color:var(--muted);font-size:18px;">
            <i class="bi bi-box-arrow-right"></i>
          </a>
        </div>
      </div>
    </aside>

    <!-- ── MAIN ───────────────────────────── -->
    <div class="app-main">

      <!-- Topbar -->
      <header class="app-topbar">
        <div class="topbar-left">
          <div class="topbar-breadcrumb">
            <i class="bi bi-house-door"></i>
            <span>/</span>
            <a href="/admin/" style="color:var(--muted);">Dashboard</a>
            <span>/</span>
            <span class="current">Users</span>
          </div>
        </div>
        <div class="topbar-right">
          <div class="topbar-dot"></div>
          <span class="topbar-badge">
            <i class="bi bi-people me-1"></i><%= users.length %> users
          </span>
        </div>
      </header>

      <main class="app-content">

        <!-- ── HERO ──────────────────────────── -->
        <div class="dash-hero" style="margin-bottom:24px;padding:28px 32px;">
          <div class="hero-content">
            <div class="hero-greeting">
              <i class="bi bi-people-fill"></i> Foydalanuvchilar
            </div>
            <h2 class="hero-title" style="font-size:22px;">
              Foydalanuvchilarni <span>boshqaring</span>
            </h2>
            <p class="hero-desc">
              Foydalanuvchi faolligini kuzating, holatini o'zgartiring va kutubxona a'zolarini tartibga soling.
            </p>
          </div>
        </div>

        <!-- ── STAT CARDS ─────────────────── -->
        <div class="stat-cards">
          <div class="stat-card-new card-indigo">
            <div class="stat-card-top">
              <div class="stat-icon-new indigo"><i class="bi bi-people-fill"></i></div>
            </div>
            <div class="stat-value-new"><%= users.length %></div>
            <div class="stat-label-new">Jami foydalanuvchilar</div>
          </div>

          <div class="stat-card-new card-green">
            <div class="stat-card-top">
              <div class="stat-icon-new green"><i class="bi bi-check-circle-fill"></i></div>
              <div class="stat-trend up"><i class="bi bi-check"></i> Active</div>
            </div>
            <div class="stat-value-new"><%= activeCount %></div>
            <div class="stat-label-new">Faol a'zolar</div>
          </div>

          <div class="stat-card-new card-gold">
            <div class="stat-card-top">
              <div class="stat-icon-new gold"><i class="bi bi-pause-circle-fill"></i></div>
              <div class="stat-trend down"><i class="bi bi-pause"></i> Blocked</div>
            </div>
            <div class="stat-value-new"><%= blockCount %></div>
            <div class="stat-label-new">Bloklangan</div>
          </div>

          <div class="stat-card-new card-cyan">
            <div class="stat-card-top">
              <div class="stat-icon-new cyan"><i class="bi bi-trash-fill"></i></div>
            </div>
            <div class="stat-value-new"><%= deleteCount %></div>
            <div class="stat-label-new">O'chirilgan</div>
          </div>
        </div>

        <!-- ── FILTERS ────────────────────── -->
        <div class="card-glass mb-3">
          <div class="row g-2 align-items-center">
            <div class="col-md-5">
              <div class="filter-input-wrapper">
                <i class="bi bi-search filter-icon"></i>
                <input type="text" class="filter-input" id="user-search" placeholder="Foydalanuvchi nomini qidiring...">
              </div>
            </div>
            <div class="col-md-3">
              <div class="filter-select-wrapper">
                <i class="bi bi-funnel filter-icon"></i>
                <select class="filter-select" id="user-status-filter">
                  <option value="">Barcha holat</option>
                  <option value="ACTIVE">✓ Faol</option>
                  <option value="BLOCK">⏸ Bloklangan</option>
                  <option value="DELETE">✗ O'chirilgan</option>
                </select>
              </div>
            </div>
            <div class="col-md-2">
              <button class="btn-clear-filters" id="user-clear-filters">
                <i class="bi bi-x-circle"></i>
                <span>Tozalash</span>
              </button>
            </div>
          </div>
        </div>

        <!-- ── USERS TABLE ────────────────── -->
        <div class="users-table-wrapper">
          <div class="table-header-bright">
            <div class="d-flex align-items-center gap-3">
              <div class="table-icon-wrapper">
                <i class="bi bi-people-fill"></i>
              </div>
              <div>
                <h4 class="mb-0 fw-bold">Barcha foydalanuvchilar</h4>
                <p class="mb-0 small" style="color:var(--muted);">Foydalanuvchi kirish huquqini boshqaring</p>
              </div>
            </div>
            <span class="user-count-badge"><%= users.length %> Users</span>
          </div>

          <div class="table-responsive">
            <table class="table-users-bright" id="users-table">
              <thead>
                <tr>
                  <th class="col-number"><i class="bi bi-hash"></i> #</th>
                  <th class="col-user"><i class="bi bi-person-circle"></i> Foydalanuvchi</th>
                  <th class="col-contact"><i class="bi bi-telephone"></i> Telefon</th>
                  <th class="col-status"><i class="bi bi-toggle-on"></i> Holat</th>
                  <th class="col-actions"><i class="bi bi-gear"></i> Amallar</th>
                </tr>
              </thead>
              <tbody>
                <% users.map(function (value, index) { %>
                <tr class="user-row user-row-bright"
                    data-name="<%= value.memberNick.toLowerCase() %>"
                    data-status="<%= value.memberStatus %>">
                  <td class="col-number">
                    <span class="row-number"><%= index + 1 %></span>
                  </td>
                  <td class="col-user">
                    <div class="user-info">
                      <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                      </div>
                      <div class="user-details">
                        <div class="user-name"><%= value.memberNick %></div>
                        <div class="user-id">ID: <%= value._id.toString().slice(-6) %></div>
                      </div>
                    </div>
                  </td>
                  <td class="col-contact">
                    <div class="contact-info">
                      <i class="bi bi-telephone-fill contact-icon"></i>
                      <span><%= value.memberPhone %></span>
                    </div>
                  </td>
                  <td class="col-status">
                    <span class="status-badge status-<%= value.memberStatus.toLowerCase() %>">
                      <i class="bi bi-<%= value.memberStatus === 'ACTIVE' ? 'check-circle' : value.memberStatus === 'BLOCK' ? 'pause-circle' : 'x-circle' %>"></i>
                      <%= value.memberStatus %>
                    </span>
                  </td>
                  <td class="col-actions">
                    <select class="status-select-bright member-status" id="<%= value._id %>">
                      <option value="ACTIVE"  <%= value.memberStatus === "ACTIVE"  ? "selected" : "" %>>✓ Active</option>
                      <option value="BLOCK"   <%= value.memberStatus === "BLOCK"   ? "selected" : "" %>>⏸ Block</option>
                      <option value="DELETE"  <%= value.memberStatus === "DELETE"  ? "selected" : "" %>>✗ Delete</option>
                    </select>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
            <div id="users-no-results" class="no-results-bright" style="display:none;">
              <div class="no-results-icon"><i class="bi bi-search"></i></div>
              <h5>Foydalanuvchi topilmadi</h5>
              <p>Qidiruv yoki filtr mezonlarini o'zgartiring</p>
            </div>
          </div>
        </div>

      </main>
    </div>
  </div>

  <% } %>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>
