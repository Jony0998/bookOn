<%- include('includes/header', { pageTitle: 'Kirish' }) %>
<body>
  <div class="ad-auth">
    <aside class="ad-auth__art" aria-hidden="true">
      <%- include('includes/girih', { cls: 'ad-girih', pid: 'login' }) %>
      <span class="ad-brand">
        <svg width="34" height="34" viewBox="0 0 40 40" style="color:#3cc3c8"><rect x="9" y="9" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" /><rect x="9" y="9" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" transform="rotate(45 20 20)" /><circle cx="20" cy="20" r="3.2" fill="#f2b53a" /></svg>
        <span><span class="ad-brand__name">Book<span>On</span></span><span class="ad-brand__tag">Boshqaruv paneli</span></span>
      </span>
      <div>
        <p class="ad-auth__quote">Har bir buyurtma ortida — <em>yangi kitobxon</em>.</p>
        <p class="ad-auth__note">Kitoblar, buyurtmalar va kitobxonlarni bitta joydan boshqaring.</p>
      </div>
    </aside>

    <section class="ad-auth__panel">
      <form class="ad-auth__form" action="/admin/login" method="POST" autocomplete="on">
        <span class="ad-eyebrow">Kutubxona hisobi</span>
        <h1>Boshqaruv paneliga kirish</h1>
        <p class="lead">Kutubxona foydalanuvchi nomi va parolini kiriting.</p>

        <div>
          <label class="form-label" for="memberNick">Foydalanuvchi nomi</label>
          <input class="form-control" id="memberNick" name="memberNick" type="text" autocomplete="username" required autofocus />
        </div>
        <div>
          <label class="form-label" for="memberPassword">Parol</label>
          <div class="input-group">
            <input class="form-control" id="memberPassword" name="memberPassword" type="password" autocomplete="current-password" required />
            <button class="ad-btn ad-btn--ghost ad-btn--sm" type="button" id="toggle-password" aria-pressed="false" style="border-radius:0 12px 12px 0;min-height:44px">Koʻrsatish</button>
          </div>
        </div>

        <button type="submit" class="ad-btn ad-btn--primary" style="min-height:52px"><i class="bi bi-box-arrow-in-right"></i> Kirish</button>
        <p class="ad-auth__switch"><a href="/" style="font-weight:700">← Saytga qaytish</a></p>
      </form>
    </section>
  </div>
  <script>
    document.getElementById("toggle-password").addEventListener("click", function () {
      var input = document.getElementById("memberPassword");
      var show = input.type === "password";
      input.type = show ? "text" : "password";
      this.textContent = show ? "Yashirish" : "Koʻrsatish";
      this.setAttribute("aria-pressed", String(show));
    });
  </script>
<%- include('includes/footer') %>
