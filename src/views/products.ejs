<%- include('includes/header', { pageTitle: 'Kitoblar' }) %>
<%
  const live = products.filter(function (p) { return p.productStatus !== 'DELETE'; });
  const genres = Object.keys(GENRE_LABEL);
  const langs = [['UZ', 'Oʻzbekcha'], ['RU', 'Ruscha'], ['EN', 'Inglizcha'], ['OTHER', 'Boshqa']];
  const img = (p) => p.productImages && p.productImages[0] ? '/' + p.productImages[0] : '/img/default.jpeg';
%>
<body>
  <div class="ad-shell">
    <%- include('includes/sidebar') %>

    <main class="ad-main">
      <header class="ad-head">
        <div>
          <span class="ad-eyebrow">Katalog</span>
          <h1>Kitoblar</h1>
          <p>Yangi kitob qoʻshing, maʼlumotlarni tahrirlang, narx, chegirma va zaxirani boshqaring.</p>
        </div>
        <div class="ad-head__actions">
          <button class="ad-btn ad-btn--primary" id="process-btn" type="button"><i class="bi bi-plus-lg"></i> Yangi kitob</button>
        </div>
      </header>

      <section class="ad-kpis" aria-label="Katalog koʻrsatkichlari">
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon"><i class="bi bi-collection"></i></span>
          <span class="ad-kpi__value ad-num"><%= live.length %></span>
          <span class="ad-kpi__label">Jami kitoblar</span>
        </div>
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon is-ok"><i class="bi bi-check2-circle"></i></span>
          <span class="ad-kpi__value ad-num"><%= products.filter(function (p) { return p.productStatus === 'PROCESS'; }).length %></span>
          <span class="ad-kpi__label">Sotuvda</span>
        </div>
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon is-gold"><i class="bi bi-pause-circle"></i></span>
          <span class="ad-kpi__value ad-num"><%= products.filter(function (p) { return p.productStatus === 'PAUSE'; }).length %></span>
          <span class="ad-kpi__label">Toʻxtatilgan</span>
          <span class="ad-kpi__sub">Saytda koʻrinmaydi</span>
        </div>
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon is-danger"><i class="bi bi-exclamation-triangle"></i></span>
          <span class="ad-kpi__value ad-num"><%= live.filter(function (p) { return p.productLeftCount < 10; }).length %></span>
          <span class="ad-kpi__label">Tugab bormoqda</span>
          <span class="ad-kpi__sub">10 donadan kam</span>
        </div>
      </section>

      <!-- CREATE FORM -->
      <section class="ad-card" id="product-form-card" style="display:none;margin-bottom:24px" aria-labelledby="new-book-title">
        <div class="ad-card__head" style="padding-bottom:18px;border-bottom:1px solid var(--line)">
          <h2 class="ad-card__title" id="new-book-title"><i class="bi bi-journal-plus"></i> Yangi kitob qoʻshish</h2>
          <button class="ad-icon-btn" id="cancel-btn" type="button" aria-label="Yopish"><i class="bi bi-x-lg"></i></button>
        </div>

        <form onsubmit="return validateForm()" action="/admin/product/create" method="POST" enctype="multipart/form-data">
          <input name="productStatus" value="PAUSE" class="product-status" type="hidden" />

          <div class="ad-form-section">
            <h3 class="ad-form-section__title"><i class="bi bi-info-circle"></i> Asosiy maʼlumot</h3>
            <div class="row g-3">
              <div class="col-md-7">
                <label class="form-label" for="new-name">Kitob nomi <span class="req">*</span></label>
                <input id="new-name" type="text" name="productName" maxlength="200" class="form-control product-name" placeholder="Masalan: Oʻtkan kunlar" required />
              </div>
              <div class="col-md-5">
                <label class="form-label" for="new-author">Muallif <span class="req">*</span></label>
                <input id="new-author" type="text" name="productAuthor" maxlength="120" class="form-control product-author" placeholder="Masalan: Abdulla Qodiriy" required />
              </div>
              <div class="col-12">
                <label class="form-label" for="new-desc">Tavsif <span class="req">*</span></label>
                <textarea id="new-desc" name="productDesc" rows="4" maxlength="5000" class="form-control product-desc" placeholder="Kitob nima haqida? 2–4 jumla kifoya."></textarea>
                <div class="ad-hint">Bu matn kitob sahifasida “Kitob haqida” boʻlimida koʻrinadi.</div>
              </div>
            </div>
          </div>

          <div class="ad-form-section">
            <h3 class="ad-form-section__title"><i class="bi bi-tag"></i> Narx va zaxira</h3>
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label" for="new-price">Narx ($) <span class="req">*</span></label>
                <input id="new-price" type="number" name="productPrice" min="0" step="0.01" class="form-control product-price" placeholder="0.00" required />
              </div>
              <div class="col-md-4">
                <label class="form-label" for="new-sale">Chegirma narxi ($)</label>
                <input id="new-sale" type="number" name="productDiscountPrice" min="0" step="0.01" class="form-control product-discount-price" placeholder="ixtiyoriy" />
                <div class="ad-hint">Asosiy narxdan kichik boʻlishi kerak.</div>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="new-stock">Omborda (dona) <span class="req">*</span></label>
                <input id="new-stock" type="number" name="productLeftCount" min="0" step="1" class="form-control product-left-count" placeholder="0" required />
              </div>
            </div>
          </div>

          <div class="ad-form-section">
            <h3 class="ad-form-section__title"><i class="bi bi-bookmark"></i> Tafsilotlar</h3>
            <div class="row g-3">
              <div class="col-md-4">
                <label class="form-label" for="productCollection">Janr <span class="req">*</span></label>
                <select class="form-select product-collection" name="productCollection" id="productCollection">
                  <% genres.forEach(function (g, i) { %><option value="<%= g %>" <%= i === 0 ? 'selected' : '' %>><%= GENRE_LABEL[g] %></option><% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="new-lang">Til <span class="req">*</span></label>
                <select class="form-select product-language" name="productLanguage" id="new-lang">
                  <% langs.forEach(function (l) { %><option value="<%= l[0] %>"><%= l[1] %></option><% }) %>
                </select>
              </div>
              <div class="col-md-4">
                <label class="form-label" for="new-isbn">ISBN</label>
                <input id="new-isbn" type="text" name="productIsbn" maxlength="20" class="form-control product-isbn" placeholder="978-…" />
              </div>
              <div class="col-md-4">
                <label class="form-label" for="new-pub">Nashriyot</label>
                <input id="new-pub" type="text" name="productPublisher" maxlength="120" class="form-control" placeholder="ixtiyoriy" />
              </div>
              <div class="col-md-4">
                <label class="form-label" for="new-year">Nashr yili</label>
                <input id="new-year" type="number" name="productPublishYear" min="1450" step="1" class="form-control" placeholder="2024" />
              </div>
              <div class="col-md-4">
                <label class="form-label" for="new-pages">Sahifalar</label>
                <input id="new-pages" type="number" name="productPages" min="1" step="1" class="form-control" placeholder="320" />
              </div>
              <div class="col-12">
                <span class="form-label d-block">Bosh sahifadagi javonlar</span>
                <input type="hidden" name="productShelves" value="" />
                <div class="ad-shelves">
                  <% shelves.forEach(function (shelf) { %>
                  <label class="ad-check"><input type="checkbox" name="productShelves" value="<%= shelf.value %>" /> <%= shelf.label %></label>
                  <% }) %>
                </div>
                <div class="ad-hint">Kitob “Kayfiyatingizga mos javon” boʻlimidagi tanlangan javonlarda chiqadi.</div>
              </div>
            </div>
          </div>

          <div class="ad-form-section">
            <h3 class="ad-form-section__title"><i class="bi bi-images"></i> Muqova rasmlari</h3>
            <div class="ad-uploads">
              <% [1, 2, 3, 4, 5].forEach(function (n) { %>
              <div class="upload-box" onclick="document.getElementById('file-<%= n %>').click()" role="button" tabindex="0" aria-label="Rasm <%= n %>">
                <img src="/img/upload.svg" class="upload-preview" id="image-section-<%= n %>" alt="" />
                <input type="file" id="file-<%= n %>" name="productImages" class="d-none" accept="image/jpeg,image/png,image/webp" onchange="previewFileHandler(this, <%= n %>)" <%= n === 1 ? 'required' : '' %> />
                <span class="upload-label"><%= n === 1 ? 'Asosiy muqova *' : 'Rasm ' + n %></span>
              </div>
              <% }) %>
            </div>
            <div class="ad-hint">JPG, PNG yoki WEBP, har biri 5 MB gacha. Birinchi rasm katalogda muqova sifatida chiqadi.</div>
          </div>

          <div class="ad-form-foot">
            <button type="button" class="ad-btn ad-btn--ghost" id="cancel-btn-footer">Bekor qilish</button>
            <button type="submit" class="ad-btn ad-btn--primary"><i class="bi bi-check2"></i> Kitobni saqlash</button>
          </div>
        </form>
      </section>

      <!-- LIST -->
      <section class="ad-card" aria-label="Kitoblar roʻyxati">
        <div class="ad-toolbar">
          <label class="ad-search">
            <i class="bi bi-search"></i>
            <span class="visually-hidden">Qidirish</span>
            <input type="search" id="search-input" placeholder="Nom yoki muallif boʻyicha qidiring" />
          </label>
          <select class="form-select ad-select" id="status-filter" aria-label="Holat" style="width:auto">
            <option value="">Barcha holatlar</option>
            <option value="PROCESS">Sotuvda</option>
            <option value="PAUSE">Toʻxtatilgan</option>
            <option value="DELETE">Oʻchirilgan</option>
          </select>
          <select class="form-select ad-select" id="type-filter" aria-label="Janr" style="width:auto">
            <option value="">Barcha janrlar</option>
            <% genres.forEach(function (g) { %><option value="<%= g %>"><%= GENRE_LABEL[g] %></option><% }) %>
          </select>
          <button class="ad-btn ad-btn--ghost ad-btn--sm" id="clear-filters" type="button"><i class="bi bi-x-circle"></i> Tozalash</button>
        </div>

        <div class="ad-table-wrap">
          <table class="ad-table" id="products-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Kitob</th>
                <th>Janr</th>
                <th>Til</th>
                <th class="is-num">Narx</th>
                <th class="is-num">Zaxira</th>
                <th>Holat</th>
                <th><span class="visually-hidden">Amallar</span></th>
              </tr>
            </thead>
            <tbody>
              <% products.forEach(function (value, key) { %>
              <tr class="product-row"
                  data-name="<%= (value.productName + ' ' + (value.productAuthor || '')).toLowerCase() %>"
                  data-status="<%= value.productStatus %>"
                  data-type="<%= value.productCollection %>">
                <td class="ad-muted ad-num"><%= key + 1 %></td>
                <td>
                  <div class="ad-book">
                    <img class="ad-thumb" src="<%= img(value) %>" alt="" onerror="this.src='/img/default.jpeg'" />
                    <div>
                      <div class="ad-book__title"><%= value.productName %></div>
                      <div class="ad-book__author"><%= value.productAuthor && value.productAuthor !== 'Unknown' ? value.productAuthor : 'Muallif kiritilmagan' %></div>
                    </div>
                  </div>
                </td>
                <td><span class="ad-tag"><%= GENRE_LABEL[value.productCollection] || value.productCollection %></span></td>
                <td><span class="ad-tag"><%= value.productLanguage || '—' %></span></td>
                <td class="is-num ad-price">
                  <% if (value.productDiscountPrice != null) { %>
                    <strong><%= money(value.productDiscountPrice) %></strong><s><%= money(value.productPrice) %></s>
                  <% } else { %>
                    <strong><%= money(value.productPrice) %></strong>
                  <% } %>
                </td>
                <td class="is-num"><span class="ad-stock <%= value.productLeftCount < 10 ? 'is-low' : '' %>"><%= value.productLeftCount %></span></td>
                <td>
                  <select class="form-select ad-status-select new-product-status" id="<%= value._id %>" aria-label="Holat: <%= value.productName %>">
                    <option value="PROCESS" <%= value.productStatus === 'PROCESS' ? 'selected' : '' %>>Sotuvda</option>
                    <option value="PAUSE"   <%= value.productStatus === 'PAUSE'   ? 'selected' : '' %>>Toʻxtatilgan</option>
                    <option value="DELETE"  <%= value.productStatus === 'DELETE'  ? 'selected' : '' %>>Oʻchirilgan</option>
                  </select>
                </td>
                <td>
                  <button type="button" class="ad-icon-btn edit-product-btn" title="Tahrirlash" aria-label="Tahrirlash: <%= value.productName %>"
                    data-product="<%= JSON.stringify({
                      _id: value._id,
                      productName: value.productName,
                      productAuthor: value.productAuthor,
                      productCollection: value.productCollection,
                      productLanguage: value.productLanguage,
                      productPrice: value.productPrice,
                      productDiscountPrice: value.productDiscountPrice,
                      productLeftCount: value.productLeftCount,
                      productIsbn: value.productIsbn,
                      productPublisher: value.productPublisher,
                      productPublishYear: value.productPublishYear,
                      productPages: value.productPages,
                      productShelves: value.productShelves || [],
                      productDesc: value.productDesc
                    }) %>">
                    <i class="bi bi-pencil"></i>
                  </button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
          <div id="no-results" class="ad-no-results" style="display:none;"><i class="bi bi-search"></i> Filtrga mos kitob topilmadi</div>
        </div>
      </section>
    </main>
  </div>

  <!-- EDIT MODAL -->
  <div class="modal fade" id="edit-product-modal" tabindex="-1" aria-labelledby="edit-product-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <form class="modal-content" id="edit-product-form" novalidate>
        <div class="modal-header">
          <h2 class="modal-title" id="edit-product-title" style="font-size:22px"><i class="bi bi-pencil-square me-2" style="color:var(--accent)"></i>Kitobni tahrirlash</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Yopish"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="_id" />
          <div class="row g-3">
            <div class="col-md-7"><label class="form-label">Kitob nomi <span class="req">*</span></label><input type="text" name="productName" class="form-control" maxlength="200" required /></div>
            <div class="col-md-5"><label class="form-label">Muallif <span class="req">*</span></label><input type="text" name="productAuthor" class="form-control" maxlength="120" required /></div>
            <div class="col-md-4"><label class="form-label">Narx ($) <span class="req">*</span></label><input type="number" name="productPrice" class="form-control" min="0" step="0.01" required /></div>
            <div class="col-md-4"><label class="form-label">Chegirma narxi ($)</label><input type="number" name="productDiscountPrice" class="form-control" min="0" step="0.01" placeholder="boʻsh = chegirmasiz" /></div>
            <div class="col-md-4"><label class="form-label">Omborda <span class="req">*</span></label><input type="number" name="productLeftCount" class="form-control" min="0" step="1" required /></div>
            <div class="col-md-4"><label class="form-label">Janr</label>
              <select name="productCollection" class="form-select"><% genres.forEach(function (g) { %><option value="<%= g %>"><%= GENRE_LABEL[g] %></option><% }) %></select>
            </div>
            <div class="col-md-4"><label class="form-label">Til</label>
              <select name="productLanguage" class="form-select"><% langs.forEach(function (l) { %><option value="<%= l[0] %>"><%= l[1] %></option><% }) %></select>
            </div>
            <div class="col-md-4"><label class="form-label">ISBN</label><input type="text" name="productIsbn" class="form-control" maxlength="20" /></div>
            <div class="col-md-4"><label class="form-label">Nashriyot</label><input type="text" name="productPublisher" class="form-control" maxlength="120" /></div>
            <div class="col-md-4"><label class="form-label">Nashr yili</label><input type="number" name="productPublishYear" class="form-control" min="1450" step="1" /></div>
            <div class="col-md-4"><label class="form-label">Sahifalar</label><input type="number" name="productPages" class="form-control" min="1" step="1" /></div>
            <div class="col-12">
              <span class="form-label d-block">Bosh sahifadagi javonlar</span>
              <div class="ad-shelves" id="edit-shelves">
                <% shelves.forEach(function (shelf) { %>
                <label class="ad-check"><input type="checkbox" value="<%= shelf.value %>" /> <%= shelf.label %></label>
                <% }) %>
              </div>
            </div>
            <div class="col-12"><label class="form-label">Tavsif</label><textarea name="productDesc" class="form-control" rows="4" maxlength="5000"></textarea></div>
          </div>
          <div class="alert alert-danger mt-3 mb-0 d-none" id="edit-product-error"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="ad-btn ad-btn--ghost" data-bs-dismiss="modal">Bekor qilish</button>
          <button type="submit" class="ad-btn ad-btn--primary" id="edit-product-save"><i class="bi bi-check2"></i> Saqlash</button>
        </div>
      </form>
    </div>
  </div>

  <script type="text/javascript" src="/js/products.js"></script>
<%- include('includes/footer') %>
