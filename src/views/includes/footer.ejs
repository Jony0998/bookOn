    <script>
      // Day / night toggle (remembered) and the mobile sidebar
      (function () {
        var root = document.documentElement;
        document.querySelectorAll(".ad-theme-toggle").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var next = root.dataset.theme === "dark" ? "light" : "dark";
            root.dataset.theme = next;
            root.dataset.bsTheme = next;
            try { localStorage.setItem("bookon-admin-theme", next); } catch (e) {}
          });
        });
        var side = document.getElementById("ad-side");
        var toggle = document.querySelector(".ad-menu-toggle");
        if (side && toggle) {
          toggle.addEventListener("click", function () {
            var open = side.classList.toggle("is-open");
            toggle.setAttribute("aria-expanded", String(open));
          });
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") { side.classList.remove("is-open"); toggle.setAttribute("aria-expanded", "false"); }
          });
        }
      })();
    </script>
    <% if (typeof admin !== "undefined" && admin) { %>
    <%# Live notifications for the signed-in library (Socket.io, same-origin session cookie) %>
    <div class="ad-toasts" role="status" aria-live="polite"></div>
    <script src="/socket.io/socket.io.js"></script>
    <script src="<%= asset('/js/admin-live.js') %>"></script>
    <% } %>
  </body>
</html>
