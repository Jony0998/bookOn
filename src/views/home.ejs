<%- include('includes/header', { pageTitle: 'Bosh panel' }) %>
<%
  const s = summary;
  const hour = new Date().getHours();
  const greet = hour < 12 ? 'Xayrli tong' : hour < 18 ? 'Xayrli kun' : 'Xayrli kech';
  const img = (p) => p && p.productImages && p.productImages[0] ? '/' + p.productImages[0] : '/img/default.jpeg';
%>
<body>
  <div class="ad-shell">
    <%- include('includes/sidebar') %>

    <main class="ad-main">
      <header class="ad-head">
        <div>
          <span class="ad-eyebrow">Bosh panel · <%= date(new Date()) %></span>
          <h1><%= greet %>, <%= admin.memberNick %></h1>
          <p>Doʻkoningizdagi bugungi holat: buyurtmalar, kitoblar zaxirasi va kitobxonlar.</p>
        </div>
        <div class="ad-head__actions">
          <a class="ad-btn ad-btn--ghost" href="/admin/order/all?status=PAUSE"><i class="bi bi-hourglass-split"></i> Kutilayotganlar</a>
          <a class="ad-btn ad-btn--primary" href="/admin/product/all#new"><i class="bi bi-plus-lg"></i> Yangi kitob</a>
        </div>
      </header>

      <!-- KPIs -->
      <section class="ad-kpis" aria-label="Asosiy koʻrsatkichlar">
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon is-ok"><i class="bi bi-cash-coin"></i></span>
          <span class="ad-kpi__value ad-num"><%= money(s.revenue) %></span>
          <span class="ad-kpi__label">Umumiy tushum</span>
          <span class="ad-kpi__sub">Soʻnggi 30 kunda: <b><%= money(s.revenue30) %></b></span>
        </div>
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon is-gold"><i class="bi bi-box-seam"></i></span>
          <span class="ad-kpi__value ad-num"><%= s.orders.pending + s.orders.process + s.orders.finish %></span>
          <span class="ad-kpi__label">Buyurtmalar</span>
          <span class="ad-kpi__sub"><b><%= s.orders.pending %></b> tasi tasdiqlanishini kutmoqda</span>
        </div>
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon"><i class="bi bi-book"></i></span>
          <span class="ad-kpi__value ad-num"><%= s.products.active %><small class="ad-muted" style="font-size:18px"> / <%= s.products.total %></small></span>
          <span class="ad-kpi__label">Sotuvdagi kitoblar</span>
          <span class="ad-kpi__sub">Omborda jami <b><%= s.products.stockUnits %></b> dona</span>
        </div>
        <div class="ad-card ad-kpi">
          <span class="ad-kpi__icon"><i class="bi bi-people"></i></span>
          <span class="ad-kpi__value ad-num"><%= s.members.active %></span>
          <span class="ad-kpi__label">Faol kitobxonlar</span>
          <span class="ad-kpi__sub">Shu hafta: <b>+<%= s.members.newWeek %></b><%= s.members.blocked ? ' · bloklangan: ' + s.members.blocked : '' %></span>
        </div>
      </section>

      <div class="ad-grid-2">
        <div class="ad-stack">
          <!-- Pipeline -->
          <section class="ad-card">
            <div class="ad-card__head">
              <h2 class="ad-card__title"><i class="bi bi-signpost-split"></i> Buyurtmalar oqimi</h2>
              <a class="ad-btn ad-btn--ghost ad-btn--sm" href="/admin/order/all">Barchasi</a>
            </div>
            <div class="ad-card__body">
              <div class="ad-pipe">
                <a href="/admin/order/all?status=PAUSE"><strong class="ad-num"><%= s.orders.pending %></strong><span class="ad-pill is-PAUSE">Kutilmoqda</span></a>
                <a href="/admin/order/all?status=PROCESS"><strong class="ad-num"><%= s.orders.process %></strong><span class="ad-pill is-PROCESS">Yoʻlda</span></a>
                <a href="/admin/order/all?status=FINISH"><strong class="ad-num"><%= s.orders.finish %></strong><span class="ad-pill is-FINISH">Yetkazildi</span></a>
              </div>
            </div>
          </section>

          <!-- Recent orders -->
          <section class="ad-card">
            <div class="ad-card__head">
              <h2 class="ad-card__title"><i class="bi bi-clock-history"></i> Soʻnggi buyurtmalar</h2>
            </div>
            <div class="ad-card__body">
              <% if (!s.recentOrders.length) { %>
                <div class="ad-empty"><i class="bi bi-inbox"></i>Hali buyurtma yoʻq</div>
              <% } else { %>
              <ul class="ad-list">
                <% s.recentOrders.forEach(function (o) { const first = o.products[0]; %>
                <li>
                  <img class="ad-thumb" src="<%= img(first) %>" alt="" onerror="this.src='/img/default.jpeg'" />
                  <div class="ad-list__main">
                    <span class="ad-list__title"><%= orderNo(o._id) %> · <%= o.member ? o.member.memberNick : 'Oʻchirilgan hisob' %></span>
                    <span class="ad-list__sub"><%= dateTime(o.createdAt) %> · <%= o.items.reduce(function (n, i) { return n + i.itemQuantity; }, 0) %> ta kitob</span>
                  </div>
                  <span class="ad-pill is-<%= o.orderStatus %>"><%= STATUS_LABEL[o.orderStatus] %></span>
                  <strong class="ad-num"><%= money(o.orderTotal) %></strong>
                </li>
                <% }) %>
              </ul>
              <% } %>
            </div>
          </section>
        </div>

        <div class="ad-stack">
          <!-- Low stock -->
          <section class="ad-card">
            <div class="ad-card__head">
              <h2 class="ad-card__title"><i class="bi bi-exclamation-triangle"></i> Tugab borayotganlar</h2>
              <span class="ad-tag"><%= lowStockLimit %> donadan kam</span>
            </div>
            <div class="ad-card__body">
              <% if (!s.lowStock.length) { %>
                <div class="ad-empty"><i class="bi bi-check2-circle"></i>Barcha kitoblar yetarli</div>
              <% } else { %>
              <ul class="ad-list">
                <% s.lowStock.forEach(function (p) { %>
                <li>
                  <img class="ad-thumb ad-thumb--sm" src="<%= img(p) %>" alt="" onerror="this.src='/img/default.jpeg'" />
                  <div class="ad-list__main">
                    <span class="ad-list__title"><%= p.productName %></span>
                    <span class="ad-list__sub"><%= p.productAuthor && p.productAuthor !== 'Unknown' ? p.productAuthor : '—' %></span>
                  </div>
                  <span class="ad-stock is-low ad-num"><%= p.productLeftCount %> dona</span>
                </li>
                <% }) %>
              </ul>
              <% } %>
            </div>
          </section>

          <!-- Most viewed -->
          <section class="ad-card">
            <div class="ad-card__head">
              <h2 class="ad-card__title"><i class="bi bi-graph-up-arrow"></i> Eng koʻp koʻrilgan</h2>
            </div>
            <div class="ad-card__body">
              <% if (!s.topViewed.length) { %>
                <div class="ad-empty"><i class="bi bi-book"></i>Sotuvda kitob yoʻq</div>
              <% } else { %>
              <ul class="ad-list">
                <% s.topViewed.forEach(function (p, i) { %>
                <li>
                  <span class="ad-num ad-muted" style="width:18px;font-weight:800"><%= i + 1 %></span>
                  <img class="ad-thumb ad-thumb--sm" src="<%= img(p) %>" alt="" onerror="this.src='/img/default.jpeg'" />
                  <div class="ad-list__main">
                    <span class="ad-list__title"><%= p.productName %></span>
                    <span class="ad-list__sub"><i class="bi bi-eye"></i> <%= p.productViews || 0 %> · <i class="bi bi-heart"></i> <%= p.productLikes || 0 %></span>
                  </div>
                </li>
                <% }) %>
              </ul>
              <% } %>
            </div>
          </section>
        </div>
      </div>
    </main>
  </div>
<%- include('includes/footer') %>
